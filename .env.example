# ===========================================
# Bonoriya Restaurant - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE (PostgreSQL for Vercel)
# ===========================================
# For Vercel Postgres, use the connection strings from your Vercel project dashboard
DATABASE_URL="postgres://default:xxxxx@xxx.postgres.vercel-storage.com/verceldb?sslmode=require"
DIRECT_DATABASE_URL="postgres://default:xxxxx@xxx.postgres.vercel-storage.com/verceldb?sslmode=require"

# For local development with SQLite (uncomment below):
# DATABASE_URL="file:./dev.db"

# ===========================================
# CLERK AUTHENTICATION
# ===========================================
# Get these from your Clerk Dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxx"
CLERK_SECRET_KEY="sk_test_xxxxx"

# Clerk URLs (optional - defaults shown)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ===========================================
# ADMIN CREDENTIALS (for seeding)
# ===========================================
# These will be used to create the default admin user
ADMIN_EMAIL="admin@bonoriya.com"
ADMIN_PASSWORD="your-secure-password"

# ===========================================
# SITE CONFIGURATION (Optional)
# ===========================================
# These can be configured via the admin panel after deployment
# SITE_NAME="Bonoriya"
# SITE_TAGLINE="Ethnic rice bowls for modern lives"
